# Copy to .env.local (gitignored). Expo inlines EXPO_PUBLIC_* at bundle time.
#
# The Commons deployment URL — the same value as REACT_APP_CONVEX_URL in the
# repo root's .env.local. It is a public client URL, not a secret.
# Leave it empty to play the offline stand-in world.
EXPO_PUBLIC_CONVEX_URL=

# Development only: start in the world instead of the title screen.
# EXPO_PUBLIC_AUTOPLAY=1
