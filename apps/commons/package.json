{
  "name": "commons-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "convex": "^1.48.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-gl": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88-stable",
    "react-native-web": "^0.21.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/react": "~19.3.0",
    "@types/three": "^0.169.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "prebuild:mobile": "expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "tvos": "EXPO_TV=1 expo run:ios --device \"Apple TV\"",
    "test": "vitest run",
    "postinstall": "patch-package"
  },
  "private": true
}
