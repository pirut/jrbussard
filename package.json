{
    "name": "jr-bussard-portfolio",
    "version": "1.0.0",
    "private": true,
    "dependencies": {
        "@auth/core": "^0.41.3",
        "@convex-dev/auth": "^0.0.95",
        "@convex-dev/rate-limiter": "^0.3.2",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@sanity/client": "^7.22.0",
        "convex": "^1.42.3",
        "convex-helpers": "^0.1.124",
        "lucide-react": "^1.44.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^6.22.3",
        "react-scripts": "^5.0.1",
        "remark-gfm": "^4.0.1",
        "three": "^0.169.0"
    },
    "scripts": {
        "start": "react-scripts start",
        "cms": "npm run dev --prefix studio-jrbussard",
        "cms:deploy": "npm run deploy --prefix studio-jrbussard",
        "cms:import": "npm run import --prefix studio-jrbussard",
        "build": "node scripts/build-site.cjs",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "commons": "node scripts/check-toolchain.js && convex dev",
        "commons:deploy": "node scripts/check-toolchain.js && convex deploy",
        "test:commons": "vitest run --config vitest.config.mjs",
        "build:frontend": "react-scripts build",
        "prayer:check": "npm --prefix prayer-backend run check",
        "prayer:test": "npm --prefix prayer-backend test",
        "prayer:deploy": "npm --prefix prayer-backend run deploy"
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "convex-test": "0.0.54",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^5.0.0"
    }
}
