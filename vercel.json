{
    "framework": "create-react-app",
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "redirects": [
        {
            "source": "/prayer/:path*",
            "has": [{ "type": "host", "value": "www.jrbussard.com" }],
            "destination": "https://prayer.jrbussard.com/:path*",
            "permanent": false
        },
        {
            "source": "/prayer/:path*",
            "has": [{ "type": "host", "value": "jrbussard.com" }],
            "destination": "https://prayer.jrbussard.com/:path*",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/contact",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
            "source": "/contact/:path*",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
            "source": "/nest",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
            "source": "/nest/:path*",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
