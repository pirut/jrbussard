# Copy to .env.local. Never commit .env.local — it is gitignored.

# ─── The Commons (multiplayer) ────────────────────────────────────────────
# Written for you by `npx convex dev`. On a fresh clone .env.local does not
# exist, and plain `npx convex dev` will CREATE A NEW PROJECT rather than use
# the existing one. Link to the right project explicitly instead:
#
#   npx convex dev --configure existing \
#     --team scottbussardjr --project ascii-commons
#
# Without REACT_APP_CONVEX_URL the site still builds and every other room
# works — only the Commons needs it.
CONVEX_DEPLOYMENT=
REACT_APP_CONVEX_URL=

# ─── Notes CMS ────────────────────────────────────────────────────────────
REACT_APP_SANITY_PROJECT_ID=8qiu273i
REACT_APP_SANITY_DATASET=production
REACT_APP_SANITY_API_VERSION=2026-04-24
REACT_APP_SANITY_STUDIO_URL=http://localhost:3333
